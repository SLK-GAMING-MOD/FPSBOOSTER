<?xml version="1.0" encoding="utf-8"?>
<!-- đặt tại FpsMaster/app/src/main/res/layout/overlay_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Panel, ẩn mặc định -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FPS Booster"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dọn RAM nền"
            android:backgroundTint="@color/accent"
            android:textColor="@color/bg_dark"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tắt nút nổi"
            android:backgroundTint="@color/text_secondary"
            android:textColor="@color/bg_dark" />

    </LinearLayout>

    <!-- Icon nổi, kéo thả được -->
    <ImageView
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_bg"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_manage"
        app:tint="@color/bg_dark"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
